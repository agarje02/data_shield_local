{
  "manifest_version": 3,
  "name": "DataShield Local",
  "version": "0.2.3",
  "description": "Checks what you paste or upload into AI tools and webmail for sensitive data, on this device.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DataShield Local",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://mail.google.com/*",
        "http://127.0.0.1:8765/ext-test*"
      ],
      "js": [
        "decide.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://mail.google.com/*",
    "http://127.0.0.1:8765/ext-test*"
  ]
}
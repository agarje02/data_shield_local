{
  "name": "datashield-local-extension",
  "private": true,
  "description": "Development tooling for the extension: pinned onnxruntime-web and pdf.js, copied into vendor/ by `npm run vendor`.",
  "scripts": {
    "vendor": "node extension/tools/vendor.mjs",
